{
  "name": "@bloknote/climbing-data-gen",
  "version": "1.0.0",
  "private": true,
  "description": "Data pipeline for fetching OSM boundaries and compiling static geographic APIs",
  "type": "module",
  "main": "src/main.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./world-points": {
      "import": "./src/world-points.ts",
      "types": "./src/world-points.ts"
    }
  },
  "scripts": {
    "build": "bun run src/main.ts",
    "update": "bun run src/main.ts --refresh"
  },
  "dependencies": {
    "@bloknote/reverse-geocoding-data": "workspace:*",
    "@turf/boolean-point-in-polygon": "catalog:",
    "geojson": "catalog:",
    "osmtogeojson": "catalog:"
  },
  "devDependencies": {
    "@bloknote/common": "workspace:*",
    "@types/bun": "catalog:",
    "@types/geojson": "catalog:",
    "@types/node": "catalog:",
    "osm-api": "catalog:",
    "typescript": "catalog:"
  }
}
