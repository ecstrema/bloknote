{
  "name": "bloknote",
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*",
    "#components": "./src/lib/components/index.js",
    "#components/*": "./src/lib/components/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "wuchale && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "wuchale && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest",
    "region-names": "bun run scripts/region-names.ts"
  },
  "dependencies": {
    "@atproto/oauth-client-browser": "catalog:",
    "@bloknote/holy-grade": "workspace:*",
    "@bloknote/osm-climbing": "workspace:*",
