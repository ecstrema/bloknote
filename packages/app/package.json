    "@types/geojson": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/devtools": "catalog:",
    "@wuchale/svelte": "catalog:",
    "bits-ui": "catalog:",
    "clsx": "catalog:",
    "fflate": "catalog:",
    "maplibre-gl": "catalog:",
    "osmtogeojson": "catalog:",
    "shadcn-svelte": "catalog:",
    "sv": "catalog:",
