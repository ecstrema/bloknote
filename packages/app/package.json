    "@sqlite.org/sqlite-wasm": "catalog:",
    "d3-scale": "catalog:",
    "layerchart": "catalog:",
    "mode-watcher": "catalog:",
    "opening_hours": "catalog:",
    "osm-api": "catalog:"
  },
  "devDependencies": {
    "@bloknote/climbing-data-gen": "workspace:*",
    "@bloknote/common": "workspace:*",
    "@bloknote/reverse-geocoding-data": "workspace:*",
    "@fontsource-variable/inter": "catalog:",
    "@iconify-json/lucide": "catalog:",
    "@iconify/tailwind4": "catalog:",
    "@internationalized/date": "catalog:",
    "@sveltejs/adapter-static": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-devtools-svelte": "^0.11.1",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
